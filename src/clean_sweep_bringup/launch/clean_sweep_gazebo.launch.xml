<launch>
    <arg name="gz_args" default="$(find-pkg-share clean_sweep_bringup)/worlds/real_corridor.sdf -r"/>
    <arg name="enable_rviz" default="true"/>

    <let name="urdf_path"
        value="$(find-pkg-share clean_sweep_description)/urdf/clean_sweep.urdf.xacro" />
    
    <let name="gazebo_config_path" 
        value ="$(find-pkg-share clean_sweep_bringup)/config/gazebo_bridge.yaml" />

    <let name="rviz_config_path"
        value="$(find-pkg-share clean_sweep_description)/rviz/urdf_config.rviz" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher">    
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" />
    </node>

    <node pkg="controller_manager" exec="spawner" output="screen"
        args="joint_state_broadcaster --controller-manager /controller_manager --param-file $(find-pkg-share clean_sweep_description)/config/controllers.yaml"/>

    <node pkg="controller_manager" exec="spawner" output="screen"
        args="diff_cont --controller-manager /controller_manager --param-file $(find-pkg-share clean_sweep_description)/config/controllers.yaml"/>
    
    <include file = "$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(var gz_args)"/>

    </include>

    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description" />
    
    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file" value="$(var gazebo_config_path)"/>
    </node>
    
    <node if="$(var enable_rviz)" pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config_path)" />
</launch>
