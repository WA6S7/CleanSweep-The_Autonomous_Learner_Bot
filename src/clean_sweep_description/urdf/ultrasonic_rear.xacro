<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="ultra_rear_length" value="0.02"/>
    <xacro:property name="ultra_rear_width"  value="0.05"/>
    <xacro:property name="ultra_rear_height" value="0.025"/>
    <xacro:property name="ultra_rear_min_range" value="0.02"/>
    <xacro:property name="ultra_rear_max_range" value="4.25"/>
    <xacro:property name="ultra_rear_range_resolution" value="0.01"/>

    <link name="ultrasonic_rear_link">
        <visual>
            <geometry>
                <box size="${ultra_rear_length} ${ultra_rear_width} ${ultra_rear_height}"/>
            </geometry>
            <material name="red"/>
        </visual>

        <collision>
            <geometry>
                <box size="${ultra_rear_length} ${ultra_rear_width} ${ultra_rear_height}"/>
            </geometry>
        </collision>

        <xacro:box_inertia 
            m="0.02" 
            x="${ultra_rear_length}" 
            y="${ultra_rear_width}" 
            z="${ultra_rear_height}"
            o_xyz="0 0 0" 
            o_rpy="0 0 0" />
    </link>

    <joint name="base_ultrasonic_rear_joint" type="fixed">
        <parent link="base_link"/>
        <child link="ultrasonic_rear_link"/>
        <origin xyz="${-(base_length/2.0) + (ultra_rear_length/2.0)} 0 0.04" rpy="0 0 3.14159"/> 
    </joint>

    <gazebo reference="ultrasonic_rear_link">
        <sensor name="ultrasonic_rear" type="gpu_lidar">
            <always_on>true</always_on>
            <update_rate>20</update_rate>
            <visualize>true</visualize>

            <lidar>
                <scan>
                    <horizontal>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </vertical>
                </scan>

                <range>
                    <min>${ultra_rear_min_range}</min>
                    <max>${ultra_rear_max_range}</max>
                    <resolution>${ultra_rear_range_resolution}</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>

            <topic>/ultrasonic_rear</topic>

        </sensor>
    </gazebo>   

</robot>
